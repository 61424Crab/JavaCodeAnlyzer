if __name__ == "__main__":
    # AWSコンソールで事前に作成したIndex Nameに置き換えてください
    AWS_PLACE_INDEX_NAME = "JapanAddressIndex"
    
    # テスト用の住所
    test_address = "神奈川県川崎市川崎区新川通4-6"

    print("AWS Location Serviceの呼び出しを開始します...")
    latitude, longitude = get_lat_lng_from_aws(test_address, AWS_PLACE_INDEX_NAME)

    if latitude and longitude:
        print("========================================")
        print(" [AWS 変換成功]")
        print(f" 変換元住所      : {test_address}")
        print(f" 緯度 (Latitude) : {latitude:.6f}")
        print(f" 経度 (Longitude): {longitude:.6f}")
        print("========================================")
